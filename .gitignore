# ──────────────────────────────────────────────────────────────
#  ReachInbox – Monorepo .gitignore
# ──────────────────────────────────────────────────────────────

# ── Node ──────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/

# ── Build outputs ─────────────────────────────────────────────
dist/
build/
out/
.output/

# ── TypeScript ────────────────────────────────────────────────
*.tsbuildinfo

# ── Environment / Secrets (NEVER commit these) ────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
# Keep .env.example files committed – they are templates only
!**/.env.example

# ── Prisma ────────────────────────────────────────────────────
# Generated Prisma client (re-generated by `prisma generate`)
apps/backend/src/generated/

# ── Vite / Frontend ───────────────────────────────────────────
apps/frontend/.vite/
apps/frontend/dist/

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log

# ── OS artifacts ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor artifacts ──────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ── Docker ────────────────────────────────────────────────────
# Local override file – use for dev-only tweaks
docker-compose.override.yml

# ── Test / Coverage ───────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc ──────────────────────────────────────────────────────
*.tgz
.cache/
tmp/
temp/
