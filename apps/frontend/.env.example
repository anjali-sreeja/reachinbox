# ──────────────────────────────────────────────────────────────
#  ReachInbox – Frontend Environment Variables
#  Copy this file to .env and fill in all values.
#  Only variables prefixed with VITE_ are exposed to the browser bundle.
#  NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────

# ── Backend API base URL ──────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000

# ── Google OAuth Client ID ────────────────────────────────────
# This is safe to expose in the browser (public identifier only).
# Must match GOOGLE_CLIENT_ID in the backend .env.
VITE_GOOGLE_CLIENT_ID=REPLACE_ME

# ── App metadata ─────────────────────────────────────────────
VITE_APP_NAME=ReachInbox
VITE_APP_VERSION=1.0.0
