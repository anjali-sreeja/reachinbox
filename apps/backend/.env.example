# ──────────────────────────────────────────────────────────────
#  ReachInbox – Backend Environment Variables
#  Copy this file to .env and fill in all values.
#  NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── PostgreSQL (matches docker-compose.yml defaults) ──────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public"

# ── Redis (matches docker-compose.yml defaults) ───────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=          # uncomment if Redis requires a password

# ── JWT ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_ME_WITH_A_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=7d

# ── Google OAuth 2.0 ──────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
# Must match an Authorised redirect URI in your Google Cloud project
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ── BullMQ / Worker settings ──────────────────────────────────
# How many jobs the worker processes in parallel
WORKER_CONCURRENCY=5
# Minimum milliseconds the worker must wait between two emails from the same sender
EMAIL_MIN_DELAY_MS=1000
# Maximum emails per sender per hour (hard cap enforced in Redis)
EMAIL_HOURLY_LIMIT=50
# BullMQ queue name (must match between backend and worker)
EMAIL_QUEUE_NAME=email-queue

# ── Ethereal SMTP (auto-provisioned at runtime – no changes needed) ──
# Leave blank; the worker creates an Ethereal test account automatically.
# Set these only if you want to override with a real SMTP server.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
